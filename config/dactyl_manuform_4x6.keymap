#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// Programmer Dvorak base keymap (Option B: firmware sends Dvorak character
// names, host OS on plain US QWERTY when using this keyboard).
//
// Layers:
//   0 BASE   — Dvorak-Programmer alphabet
//   1 SYM    — symbols on top row (Programmer Dvorak style), numbers on row 1
//   2 NAV    — arrows on right home row, home/end/pgup/pgdn above
//   3 ADJUST — BT profiles + output toggle + layout switch (tri-layer: SYM+NAV)
//   4 QWERTY — standard QWERTY alphabet
//              ADJUST top-right corner switches TO QWERTY,
//              ADJUST top-left corner switches BACK to BASE.
//
// Physical layout (per verified transform):
//   Row 0 (top):   TAB   ;   ,   .   P   Y   |   F   G   C   R   L   /
//   Row 1 (home):  ESC   A   O   E   U   I   |   D   H   T   N   S   -
//   Row 2 (bot):   LSFT  '   Q   J   K   X   |   B   M   W   V   Z   RSFT
//   Row 3 (D15):   NAV SYM SPC BSPC TAB ENT SYM NAV
//                  ↑───ext───↑ ↑───thumb───↑ ↑───ext───↑
//   Row 4 (D18):   GUI CTL ALT DEL DEL ALT CTL GUI      (all thumb, "tricky")

// missing: CARET
// missing: backtick

#define BASE   0
#define SYM    1
#define NAV    2
#define ADJUST 3
#define QWERTY 4

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <SYM NAV>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
&kp TAB    &kp SEMI    &kp COMMA   &kp DOT     &kp P       &kp Y           &kp F       &kp G       &kp C       &kp R       &kp L       &kp FSLH
&kp ESC    &kp A       &kp O       &kp E       &kp U       &kp I           &kp D       &kp H       &kp T       &kp N       &kp S       &kp MINUS
&kp LSHFT  &kp SQT     &kp Q       &kp J       &kp K       &kp X           &kp B       &kp M       &kp W       &kp V       &kp Z       &kp BSLH
                       &mo NAV     &mo SYM     &mo SYM     &kp ENTER       &kp LALT    &kp SPACE   &mo SYM     &mo NAV
                       &kp LGUI    &kp LCTRL   &kp LALT    &kp LCTRL       &kp BSPC    &kp RALT    &kp RCTRL   &kp RGUI
            >;
        };

        sym_layer {
            bindings = <
&kp DLLR   &kp N7      &kp N5      &kp N3      &kp N1      &kp N9          &kp N0      &kp N2      &kp N4      &kp N6      &kp N8      &kp AT
&kp AMPS   &kp LBKT    &kp LBRC    &kp RBRC    &kp LPAR    &kp EQUAL       &kp STAR    &kp RPAR    &kp PLUS    &kp RBKT    &kp EXCL    &kp HASH      
&kp CARET  &kp F1      &kp F2      &kp F3      &kp F4      &kp F5          &kp F6      &kp F7      &kp F8      &kp F9      &kp F10     &kp PRCNT
                       &trans      &trans      &trans      &trans          &trans      &trans      &trans      &trans
                       &trans      &trans      &trans      &trans          &trans      &trans      &trans      &trans
            >;
        };

        nav_layer {
            bindings = <
&trans     &trans      &trans      &trans      &trans      &trans          &kp HOME    &kp PG_DN   &kp PG_UP   &kp END     &trans      &trans
&trans     &kp LGUI    &kp LALT    &kp LCTRL   &kp LSHFT   &trans          &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &trans      &trans
&trans     &trans      &trans      &trans      &trans      &trans          &trans      &trans      &trans      &trans      &trans      &trans
                       &trans      &trans      &trans      &trans          &trans      &trans      &trans      &trans
                       &trans      &trans      &trans      &trans          &trans      &trans      &trans      &trans
            >;
        };

        adjust_layer {
            bindings = <
&to BASE   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4  &trans      &trans      &trans      &trans      &trans    &to QWERTY
&trans     &bt BT_CLR   &out OUT_TOG &sys_reset &trans     &trans          &trans      &trans      &trans      &trans      &trans      &trans
&trans     &trans      &trans      &trans      &sys_reset  &bootloader     &bootloader &sys_reset  &trans      &trans      &trans      &trans
                       &trans      &trans      &trans      &trans          &trans      &trans      &trans      &trans
                       &trans      &trans      &trans      &trans          &trans      &trans      &trans      &trans
            >;
        };

        // Standard QWERTY. Thumb/extras mirror base so tri-layer to ADJUST still
        // works (hold SYM+NAV, then top-left of ADJUST returns to BASE).
        qwerty_layer {
            bindings = <
&kp TAB    &kp Q       &kp W       &kp E       &kp R       &kp T           &kp Y       &kp U       &kp I       &kp O       &kp P       &kp LBKT
&kp ESC    &kp A       &kp S       &kp D       &kp F       &kp G           &kp H       &kp J       &kp K       &kp L       &kp SEMI    &kp SQT
&kp LSHFT  &kp Z       &kp X       &kp C       &kp V       &kp B           &kp N       &kp M       &kp COMMA   &kp DOT     &kp FSLH    &kp RSHFT
                       &mo NAV     &mo SYM     &mo SYM     &kp ENTER       &kp LALT    &kp SPACE   &mo SYM     &mo NAV
                       &kp LGUI    &kp LCTRL   &kp LALT    &kp LCTRL       &kp BSPC    &kp RALT    &kp RCTRL   &kp RGUI
            >;
        };
    };
};
