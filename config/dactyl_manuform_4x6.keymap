#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// DIAGNOSTIC KEYMAP
// -----------------
// Every physical position outputs a unique KEY_* code (verify with evtest).
//
// LEFT half (26 keys):
//   Row 0 (top):   Q W E R T Y
//   Row 1:         A S D F G H
//   Row 2:         Z X C V B N
//   Row 3 extras:          3 4       (under B, N)
//   Row 4 thumb:   5 6 7 8 9 0
//
// RIGHT half (26 keys, once wired):
//   Row 0 (top):   U I O P LBKT RBKT
//   Row 1:         J K L SEMI SQT BSLH
//   Row 2:         M , . / MINUS EQUAL
//   Row 3 extras:                    F11 F12
//   Row 4 thumb:   F1 F2 F3 F4 F5 F6

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y         &kp U       &kp I       &kp O       &kp P       &kp LBKT    &kp RBKT
&kp A     &kp S     &kp D     &kp F     &kp G     &kp H         &kp J       &kp K       &kp L       &kp SEMI    &kp SQT     &kp BSLH
&kp Z     &kp X     &kp C     &kp V     &kp B     &kp N         &kp M       &kp COMMA   &kp DOT     &kp FSLH    &kp MINUS   &kp EQUAL
                                        &kp N3    &kp N4                                                        &kp F11     &kp F12
&kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0        &kp F1      &kp F2      &kp F3      &kp F4      &kp F5      &kp F6
            >;
        };
    };
};
