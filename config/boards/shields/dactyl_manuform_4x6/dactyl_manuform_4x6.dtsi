#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        // Left half: cols 0-5 (D4..D9 outer-pinky to inner-index)
        // Right half: cols 6-11 (right's D4..D9 offset by 6 in combined space)
        //
        // Row 3 (extras) populated under ring/middle physically
        //   Left extras:  matrix cols 2,3 (D6, D7)
        //   Right extras: matrix cols 2,3 on right MCU (D7, D6 after col reversal),
        //                 which become combined cols 8,9
        // Row 4 = thumb cluster, all 6 cols populated
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)   RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)   RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)   RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                            RC(3,2) RC(3,3)                                   RC(3,8) RC(3,9)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)   RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
        >;
    };

    // Base kscan node. Cols are identical on both halves.
    // Rows are added per-half in the *_left.overlay / *_right.overlay files.
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";

        // Columns, left-to-right on the left half (pinky-outer -> index-inner)
        //   D4  pinky outer
        //   D5  pinky
        //   D6  ring
        //   D7  middle
        //   D8  index
        //   D9  index inner
        col-gpios
            = <&pro_micro 4 GPIO_ACTIVE_HIGH>
            , <&pro_micro 5 GPIO_ACTIVE_HIGH>
            , <&pro_micro 6 GPIO_ACTIVE_HIGH>
            , <&pro_micro 7 GPIO_ACTIVE_HIGH>
            , <&pro_micro 8 GPIO_ACTIVE_HIGH>
            , <&pro_micro 9 GPIO_ACTIVE_HIGH>
            ;
    };
};
