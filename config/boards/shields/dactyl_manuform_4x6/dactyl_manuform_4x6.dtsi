#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout_0;
    };

    // Physical layout for ZMK Studio.
    // Units: 1/100 key-unit (100 = 19.05 mm). Rotation: CW-positive, 1/100 deg.
    //
    // Positions were extracted from the actual generated OpenSCAD plate
    // (dactyl-keyboard 4x6 STANDARD DEFAULT config), not from eyeballing.
    // Left-half key centers come straight from parsing the SCAD's per-plate
    // transform stack; right half is mirrored around x = 100 mm.
    //
    // Ordering matches the matrix_transform positions 0..51 below:
    //   rows 0..2:  LEFT c0..5, then RIGHT c6..11 (row-major)
    //   row 3 ext:  LEFT c2,c3 | RIGHT c8,c9
    //   row 3 top:  LEFT c4,c5 | RIGHT c6,c7   (top thumb pair)
    //   row 4 mid:  LEFT c4,c5 | RIGHT c6,c7   (mid thumb pair)
    //   row 4 bot:  LEFT c2,c3 | RIGHT c8,c9   (bot thumb pair)
    physical_layout_0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Oponn (dactyl-manuform 4x6)";
        kscan = <&kscan0>;
        transform = <&default_transform>;

        keys
            //                                W    H       X       Y      ROT       RX      RY
            = <&key_physical_attrs          100  100   (-286)  (-135)       0    (-236)   (-85)>   // pos 0 RC(0,0) L
            , <&key_physical_attrs          100  100   (-174)  (-135)       0    (-124)   (-85)>   // pos 1 RC(0,1) L
            , <&key_physical_attrs          100  100    (-57)  (-167)       0      (-7)  (-117)>   // pos 2 RC(0,2) L
            , <&key_physical_attrs          100  100       58  (-181)       0       108   (-131)>   // pos 3 RC(0,3) L
            , <&key_physical_attrs          100  100      157  (-167)       0       207   (-117)>   // pos 4 RC(0,4) L
            , <&key_physical_attrs          100  100      258  (-167)       0       308   (-117)>   // pos 5 RC(0,5) L
            , <&key_physical_attrs          100  100      692  (-167)       0       742   (-117)>   // pos 6 RC(0,6) R
            , <&key_physical_attrs          100  100      793  (-167)       0       843   (-117)>   // pos 7 RC(0,7) R
            , <&key_physical_attrs          100  100      892  (-181)       0       942   (-131)>   // pos 8 RC(0,8) R
            , <&key_physical_attrs          100  100     1007  (-167)       0      1057   (-117)>   // pos 9 RC(0,9) R
            , <&key_physical_attrs          100  100     1124  (-135)       0      1174    (-85)>   // pos10 RC(0,10) R
            , <&key_physical_attrs          100  100     1236  (-135)       0      1286    (-85)>   // pos11 RC(0,11) R
            , <&key_physical_attrs          100  100    (-285)   (-19)      0     (-235)      31>   // pos12 RC(1,0) L
            , <&key_physical_attrs          100  100    (-171)   (-19)      0     (-121)      31>   // pos13 RC(1,1) L
            , <&key_physical_attrs          100  100     (-53)   (-50)      0       (-3)       0>   // pos14 RC(1,2) L
            , <&key_physical_attrs          100  100        63   (-65)      0        113    (-15)>   // pos15 RC(1,3) L
            , <&key_physical_attrs          100  100       163   (-50)      0        213       0>   // pos16 RC(1,4) L
            , <&key_physical_attrs          100  100       266   (-50)      0        316       0>   // pos17 RC(1,5) L
            , <&key_physical_attrs          100  100       684   (-50)      0        734       0>   // pos18 RC(1,6) R
            , <&key_physical_attrs          100  100       787   (-50)      0        837       0>   // pos19 RC(1,7) R
            , <&key_physical_attrs          100  100       887   (-65)      0        937    (-15)>   // pos20 RC(1,8) R
            , <&key_physical_attrs          100  100      1003   (-50)      0       1053       0>   // pos21 RC(1,9) R
            , <&key_physical_attrs          100  100      1121   (-19)      0       1171      31>   // pos22 RC(1,10) R
            , <&key_physical_attrs          100  100      1235   (-19)      0       1285      31>   // pos23 RC(1,11) R
            , <&key_physical_attrs          100  100    (-286)      98      0     (-236)     148>   // pos24 RC(2,0) L
            , <&key_physical_attrs          100  100    (-174)      98      0     (-124)     148>   // pos25 RC(2,1) L
            , <&key_physical_attrs          100  100     (-57)      67      0       (-7)     117>   // pos26 RC(2,2) L
            , <&key_physical_attrs          100  100        58      52      0        108     102>   // pos27 RC(2,3) L
            , <&key_physical_attrs          100  100       157      67      0        207     117>   // pos28 RC(2,4) L
            , <&key_physical_attrs          100  100       258      67      0        308     117>   // pos29 RC(2,5) L
            , <&key_physical_attrs          100  100       692      67      0        742     117>   // pos30 RC(2,6) R
            , <&key_physical_attrs          100  100       793      67      0        843     117>   // pos31 RC(2,7) R
            , <&key_physical_attrs          100  100       892      52      0        942     102>   // pos32 RC(2,8) R
            , <&key_physical_attrs          100  100      1007      67      0       1057     117>   // pos33 RC(2,9) R
            , <&key_physical_attrs          100  100      1124      98      0       1174     148>   // pos34 RC(2,10) R
            , <&key_physical_attrs          100  100      1236      98      0       1286     148>   // pos35 RC(2,11) R
            , <&key_physical_attrs          100  100     (-68)     175      0      (-18)     225>   // pos36 RC(3,2) L (ext ring)
            , <&key_physical_attrs          100  100        43     161      0         93     211>   // pos37 RC(3,3) L (ext mid)
            , <&key_physical_attrs          100  100       907     161      0        957     211>   // pos38 RC(3,8) R (ext mid)
            , <&key_physical_attrs          100  100      1017     175      0       1067     225>   // pos39 RC(3,9) R (ext ring)
            , <&key_physical_attrs          100  100       148     217     759       198     267>   // pos40 RC(3,4) L (top thumb outer)
            , <&key_physical_attrs          100  100       257     209  (-8047)      307     259>   // pos41 RC(3,5) L (top thumb inner)
            , <&key_physical_attrs          100  100       693     209    8047       743     259>   // pos42 RC(3,6) R (top thumb inner)
            , <&key_physical_attrs          100  100       802     217   (-759)      852     267>   // pos43 RC(3,7) R (top thumb outer)
            , <&key_physical_attrs          100  100       241     340  (-4528)      291     390>   // pos44 RC(4,4) L (mid outer)
            , <&key_physical_attrs          100  100       357     263  (-5631)      407     313>   // pos45 RC(4,5) L (mid inner)
            , <&key_physical_attrs          100  100       593     263    5631       643     313>   // pos46 RC(4,6) R (mid inner)
            , <&key_physical_attrs          100  100       709     340    4528       759     390>   // pos47 RC(4,7) R (mid outer)
            , <&key_physical_attrs          100  100       287     419  (-3317)      337     469>   // pos48 RC(4,2) L (bot outer)
            , <&key_physical_attrs          100  100       385     358  (-4207)      435     408>   // pos49 RC(4,3) L (bot inner)
            , <&key_physical_attrs          100  100       565     358    4207       615     408>   // pos50 RC(4,8) R (bot inner)
            , <&key_physical_attrs          100  100       663     419    3317       713     469>   // pos51 RC(4,9) R (bot outer)
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        // Left half: cols 0-5 (D4..D9 outer-pinky to inner-index)
        // Right half: cols 6-11 (right's D4..D9 offset by 6 in combined space)
        //
        // Positions are ordered PHYSICALLY, not by matrix scan, so keymap
        // bindings can be written in a shape that mirrors the actual key
        // positions on the board:
        //
        //   positions 0..35   alphabet rows 0-2 (row-major)
        //   positions 36..39  ext keys — the two per half on the thumb-row
        //                     wiring (D15) that sit under middle/ring finger
        //                     rather than on the thumb pod
        //   positions 40..43  top thumb pair per half — the easy sweep-friendly
        //                     top of the thumb pod
        //   positions 44..47  mid thumb pair per half — RC(4,5)/(4,6) are
        //                     sweep-friendly
        //   positions 48..51  bot thumb pair per half — further-reach keys
        //
        // Per-half physical thumb pod (left half shown; right is mirrored):
        //     RC(3,4) RC(3,5)         <- top (easy, both sweep)
        //         RC(4,4) RC(4,5)     <- mid (RC(4,5) sweep)
        //         RC(4,2) RC(4,3)     <- bot (further reach)
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)   RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)   RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)   RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)

                            RC(3,2) RC(3,3)                                                                    RC(3,8) RC(3,9)

                                    RC(3,4) RC(3,5)                                    RC(3,6) RC(3,7)
                                            RC(4,4) RC(4,5)                    RC(4,6) RC(4,7)
                                            RC(4,2) RC(4,3)                    RC(4,8) RC(4,9)
        >;
    };

    // Base kscan node. Cols are identical on both halves.
    // Rows are added per-half in the *_left.overlay / *_right.overlay files.
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";

        // Columns, left-to-right on the left half (pinky-outer -> index-inner)
        //   D4  pinky outer
        //   D5  pinky
        //   D6  ring
        //   D7  middle
        //   D8  index
        //   D9  index inner
        col-gpios
            = <&pro_micro 4 GPIO_ACTIVE_HIGH>
            , <&pro_micro 5 GPIO_ACTIVE_HIGH>
            , <&pro_micro 6 GPIO_ACTIVE_HIGH>
            , <&pro_micro 7 GPIO_ACTIVE_HIGH>
            , <&pro_micro 8 GPIO_ACTIVE_HIGH>
            , <&pro_micro 9 GPIO_ACTIVE_HIGH>
            ;
    };
};
